# web-3d-builder config
# By: ColliBoy
# Any key left out keeps the built-in default

[webserver]
host = "localhost"       # Bind address for gunicorn (any valid host name or IP)
port = 8181              # TCP port, an integer from 1 to 65535
workers = 1              # Worker processes, keep at 1 - sessions live in process memory
open_browser = true      # Open the app in your default browser when the server starts; false disables it
local_libraries = false  # Mirror the three.js build + addons into js_libraries/ inside the project at startup, then serve them locally; false keeps fetching from jsdelivr and deletes any leftover mirror

[viewport]
smooth_shading = false  # true: smooth/rounded normals, false: flat faceted shading (the default)
lod_enabled = true      # Level-of-detail switching by camera distance, on/off
view_mode = "normal"    # Initial object display style: "normal", "wireframe", "transparent", or "wireframe-hybrid"
camera_far = 100000     # Camera far plane in mm; geometry beyond this distance is clipped (raise for huge models)

[build_plate]
visible = true             # Show the plate furniture (grid, surface, border, crosshair)
infinite = true            # Auto-scale the plate to fit all loaded objects
simple_plate = true        # Stretch the plate instead of rebuilding it on resize (cheaper)
axis_lines_visible = true  # X/Y/Z axis stubs drawn at the origin
default_size_mm = 10.0     # Initial/fixed plate edge length in mm

[snap]
grid_enabled = false  # Grid snapping on at startup
grid_size_mm = 1.0    # Snap cell size in mm, any positive number
smart_enabled = true  # Magnetic drag-snap: whole-mm moves, 45-degree rotations

[ui]
units = "mm"              # Display unit for dimensions: "mm", "cm", or "in"
theme = "night"           # "night" (dark UI) or "day" (light UI)
aesthetic_mode = false    # Cinematic lighting treatment (warm key, cool fill); off by default
even_lighting = false     # Flatten the lighting so all surfaces are lit evenly
messages_muted = false    # Suppress setting-change toast messages
rotate_pivot = "center"   # Rotation pivot: "center" (object bbox) or "origin" (world 0,0,0)
preview_shrink = true     # Shrink Scene Objects preview boxes to fit when there are too many; false keeps the old scroll/stack behavior
tip_mode = false          # Show a persistent box (top-right) describing whichever button is hovered over; off by default
view_cube_visible = true  # Orientation indicator (axis gizmo) in the top-left corner of the viewport; always hidden in aesthetic mode

[import]
separation_enabled = true   # Move newly imported shapes so their bounding box lands at least min_gap_mm away from every existing shape's bounding box; false keeps them wherever plate-snap leaves them
min_gap_mm = 5.0            # Minimum clear distance in mm between an imported shape's bounding box and any other shape's bounding box

[ai_generation]
max_tokens_per_turn = 4096  # Completion budget per model turn (thinking + output); raise for models that over-think
max_iterations = 12         # Max build/fix cycles before the job is declared failed
reasoning_effort = "low"    # Sent to the API as reasoning_effort; "none"/blank disables it. Some models honor low/medium/high
cleanup_enabled = true      # Sweep leftover job folders from ai/input + ai/output when AI mode opens, and delete each job's scratch dirs on completion; false keeps them (e.g. for debugging)
